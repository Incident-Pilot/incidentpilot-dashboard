# Observation Gateway (incident-pilot-ecommerce) — required for Phase 1.
# Point this at a `kubectl port-forward` of the gateway service, e.g.
# GATEWAY_URL=http://localhost:8000
GATEWAY_URL=
GATEWAY_API_KEY=

# Intelligence Plane investigation API (incident-pilot-agent watch service).
# REQUIRED for the "Investigate" button to work — without this, investigation
# triggering will fail with 500.
#
# Development: use kubectl port-forward, e.g.:
#   kubectl port-forward -n <namespace> svc/agent-service 8100:8100
#   AGENT_API_URL=http://localhost:8100
#
# Production: point directly to the service (Kubernetes DNS or load balancer):
#   AGENT_API_URL=http://agent-service:8100  (or FQDN/external IP)
#
# The agent API serves both:
#   - GET /investigations/{incident_id} — read completed investigations
#   - POST /investigations/{incident_id} — trigger new investigation (requires auth)
AGENT_API_URL=
# Bearer token the agent API requires on every route except /health — same
# value as AGENT_API_KEY on the agentic_layer watch service.
# Required for investigation triggering to work.
AGENT_API_KEY=

# Single-user dashboard login (proxy.ts protects every route except /login
# and its API route). No user table, no OAuth -- one hardcoded username and
# a bcrypt hash of one password.
DASHBOARD_USERNAME=

# Never put the plaintext password here -- generate the hash once with the
# bundled bcryptjs dependency, e.g.:
#   node -e "console.log(require('bcryptjs').hashSync('your-chosen-password', 12))"
DASHBOARD_PASSWORD_HASH=

# Signs/encrypts the session cookie (iron-session). Generate a random 32+
# byte secret, e.g.:
#   openssl rand -base64 32
# Rotating this value invalidates all existing sessions.
SESSION_SECRET=
