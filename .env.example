# Observation Gateway (incident-pilot-ecommerce) — required for Phase 1.
# Point this at a `kubectl port-forward` of the gateway service, e.g.
# GATEWAY_URL=http://localhost:8000
GATEWAY_URL=
GATEWAY_API_KEY=

# Intelligence Plane read API (incident-pilot-agent) — does not exist yet.
# Leave unset for Phase 1; lib/investigation.ts falls back to an honest
# "no investigation data available yet" state when this is empty.
# Once GET /investigations/{incident_id} exists, set this (and whatever
# auth env var that API ends up needing) and fill in the real fetch in
# lib/investigation.ts.
AGENT_API_URL=
