# Observation Gateway (incident-pilot-ecommerce) — required for Phase 1.
# Point this at a `kubectl port-forward` of the gateway service, e.g.
# GATEWAY_URL=http://localhost:8000
GATEWAY_URL=
GATEWAY_API_KEY=

# Intelligence Plane read API (incident-pilot-agent), served alongside its
# `watch` process. Point this at that process's investigation API, e.g.
# AGENT_API_URL=http://localhost:8100
# Leave unset to fall back to an honest "no investigation data available
# yet" state instead of an error.
AGENT_API_URL=
# Bearer token the agent API requires on every route but /health — same
# value as that project's own AGENT_API_KEY env var.
AGENT_API_KEY=

# Single-user dashboard login (proxy.ts protects every route except /login
# and its API route). No user table, no OAuth -- one hardcoded username and
# a bcrypt hash of one password.
DASHBOARD_USERNAME=

# Never put the plaintext password here -- generate the hash once with the
# bundled bcryptjs dependency, e.g.:
#   node -e "console.log(require('bcryptjs').hashSync('your-chosen-password', 12))"
DASHBOARD_PASSWORD_HASH=

# Signs/encrypts the session cookie (iron-session). Generate a random 32+
# byte secret, e.g.:
#   openssl rand -base64 32
# Rotating this value invalidates all existing sessions.
SESSION_SECRET=
